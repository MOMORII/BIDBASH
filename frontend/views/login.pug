extends layout

block content
    section.login-page
        h1 Login

        p Sign in to access BIDBASH account features.

        if error
            p.login-error= error

        form(method="POST" action="/login")
            .form-group
                label(for="username") Username
                input#username(
                    type="text"
                    name="username"
                    required
                )

            .form-group
                label(for="password") Password
                input#password(
                    type="password"
                    name="password"
                    required
                )

            button.primary-button(type="submit") Login