doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title= pageTitle
        link(rel="stylesheet" href="/css/style.css")

    body
        header.site-header
            .topbar
                a.logo(href="/moderation") BIDBASH Moderation

                nav.main-nav
                    a(href="/moderation") Dashboard

                form(method="POST" action="/logout")
                    button(type="submit") Logout

        main.page-content
            block content

        script(src="/js/main.js")