doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title= pageTitle
        link(rel="stylesheet" href="/css/style.css")

    body
        header.site-header
            .topbar
                .header-left
                    button.sidebar-toggle(
                        type="button"
                        id="sidebar-toggle"
                        aria-label="Open navigation menu"
                    ) ☰

                    a.logo(href="/") BIDBASH

                nav.main-nav
                    a(href="/") Home
                    a(href="/browse") Browse

                    if user
                        a(href=`/users/${user.id}/listings`) My Listings
                        a(href=`/users/${user.id}/bids`) My Bids
                    else
                        a(href="/sell") Sell

                .account-nav
                    if user
                        span.account-status
                            | Logged in as 
                            strong= user.username

                        if user.role === "moderator"
                            a(href="/moderation") Moderation

                        form.logout-form(method="POST" action="/logout")
                            button.logout-button(type="submit") Logout

                    else
                        a(href="/login") Login
                        a.button-link(href="/register") Sign Up

        main.page-content
            block content

        script(src="/js/main.js")