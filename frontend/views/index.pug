extends layout

block content
    section.dashboard-top.home-top
        .dashboard-header
            .dashboard-heading
                h1 BIDBASH
                p Discover active auctions, track competitive listings, and bid with confidence.
        .dashboard-visual
            img.header-image(
                src="/images/header-img.png"
                alt="BIDBASH illustration"
            )

    section.hero-section
        .hero-copy
            h2 Find your next auction win

            p
                | Browse active listings, discover ending-soon auctions, and find items that interest you.

            .hero-actions
                a.primary-button(href="/browse") Browse Auctions

                if user
                    a.secondary-button(
                        href=`/users/${user.id}/bids`
                    ) View My Bids

                else
                    a.secondary-button(
                        href="/register"
                    ) Create Account

        .hero-visual
            img.hero-image(
                src="/images/hero-img.png"
                    alt="Featured auction"
            )

    section.home-section
        .home-section-heading
            .home-section-title
                h2 Featured Auctions
                p Selected auctions currently highlighted on BIDBASH.

            .home-section-actions
                a.home-view-all(
                    href="/browse?sort=featured"
                ) View All

                button.carousel-button(
                    type="button"
                    data-carousel="featured-carousel"
                    data-direction="left"
                    aria-label="Scroll featured auctions left"
                ) ‹

                button.carousel-button(
                    type="button"
                    data-carousel="featured-carousel"
                    data-direction="right"
                    aria-label="Scroll featured auctions right"
                ) ›

        .auction-carousel#featured-carousel
            each auction in featuredAuctions
                article.auction-card.carousel-card
                    .auction-card-image
                        | Product Image

                    .auction-card-content
                        h3= auction.title

                        p
                            strong Current Bid:
                            |  £#{auction.currentBid.toFixed(2)}

                        p
                            strong Bids:
                            |  #{auction.bidCount}

                        p
                            strong Time Remaining:
                            |  #{auction.timeRemaining}

                        a.secondary-button(
                            href=`/auction/${auction.id}`
                        ) View Auction

    section.home-section
        .home-section-heading
            .home-section-title
                h2 Ending Soon
                p Auctions with the shortest remaining time.

            .home-section-actions
                a.home-view-all(
                    href="/browse?sort=ending-soon"
                ) View All

                button.carousel-button(
                    type="button"
                    data-carousel="ending-soon-carousel"
                    data-direction="left"
                    aria-label="Scroll ending-soon auctions left"
                ) ‹

                button.carousel-button(
                    type="button"
                    data-carousel="ending-soon-carousel"
                    data-direction="right"
                    aria-label="Scroll ending-soon auctions right"
                ) ›

        .auction-carousel#ending-soon-carousel
            each auction in endingSoonAuctions
                article.auction-card.carousel-card
                    .auction-card-image
                        | Product Image

                    .auction-card-content
                        h3= auction.title

                        p
                            strong Current Bid:
                            |  £#{auction.currentBid.toFixed(2)}

                        p
                            strong Bids:
                            |  #{auction.bidCount}

                        p
                            strong Time Remaining:
                            |  #{auction.timeRemaining}

                        a.secondary-button(
                            href=`/auction/${auction.id}`
                        ) View Auction