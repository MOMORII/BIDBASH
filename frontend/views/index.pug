extends layout

block content
    section.hero
        .hero-text
            h1 Find your next auction win
            p Browse active listings, compare bids, and track auctions as they happen.
            a.primary-button(href="/browse") Browse Auctions

    section.home-section
        .section-heading
            h2 Featured Auctions
            a(href="/browse") View all

        .auction-grid
            article.auction-card
                .image-placeholder Product Image
                h3 Retro Handheld Console
                p Current bid: £85
                p Time remaining: 2h 14m
                a.secondary-button(href="/auction") View Auction

            article.auction-card
                .image-placeholder Product Image
