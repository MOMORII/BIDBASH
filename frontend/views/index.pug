extends layout

block content

    section.dashboard-top.home-top

        .dashboard-header

            .dashboard-heading

                h1 BID, BASH, BATTLE

                p Welcome to BIDBASH, the ultimate online auction platform where you can discover, bid, and win items of all kinds!

        .dashboard-visual

            img.header-image#home-header-image(
                src="/images/header-img.png"
                alt="BIDBASH illustration"
            )

    section.hero-section

        .hero-copy

            if user

                h2 WELCOME BACK, #{user.username}!

            else

                h2 SIGN UP & PLACE YOUR FIRST BID TODAY

            p
                | Browse our active listings, find something new, and start bidding on your favorite items. Join our community of bidders and sellers, and experience online auctions like never before.

            .hero-actions

                a.primary-button(
                    href="/browse"
                ) Browse Auctions

                if user

                    a.secondary-button(
                        href=`/users/${user.id}/bids`
                    ) View My Bids

                else

                    a.secondary-button(
                        href="/register"
                    ) Create Account

        .hero-visual

            img.hero-image#home-hero-image(
                src="/images/hero-img.png"
                alt="Featured auction"
            )

    section.home-section

        .home-section-heading

            .home-section-title

                h2 FEATURED AUCTIONS

                p Here are some of our most popular auctions, handpicked for you!

            .home-section-actions

                a.home-view-all(
                    href="/browse?sort=featured"
                ) VIEW ALL

                button.carousel-button(
                    type="button"
                    data-carousel="featured-carousel"
                    data-direction="left"
                    aria-label="Scroll featured auctions left"
                ) ‹

                button.carousel-button(
                    type="button"
                    data-carousel="featured-carousel"
                    data-direction="right"
                    aria-label="Scroll featured auctions right"
                ) ›

        .auction-carousel#featured-carousel

            each auction in featuredAuctions

                article.auction-card.carousel-card

                    .auction-card-image

                        if auction.imagePath

                            img(
                                src=auction.imagePath
                                alt=auction.title
                            )

                        else

                            | Product Image

                    .auction-card-content

                        h3= auction.title

                        p
                            strong Current Bid:
                            |  £#{auction.currentBid.toFixed(2)}

                        p
                            strong Bids:
                            |  #{auction.bidCount}

                        p
                            strong Time Remaining:
                            |  #{auction.timeRemaining}

                        a.secondary-button(
                            href=`/auction/${auction.id}`
                        ) View Auction

    section.home-section

        .home-section-heading

            .home-section-title

                h2 ENDING SOON

                p Hurry! These auctions are about to close. Place your bids before it's too late!

            .home-section-actions

                a.home-view-all(
                    href="/browse?sort=ending-soon"
                ) VIEW ALL

                button.carousel-button(
                    type="button"
                    data-carousel="ending-soon-carousel"
                    data-direction="left"
                    aria-label="Scroll ending-soon auctions left"
                ) ‹

                button.carousel-button(
                    type="button"
                    data-carousel="ending-soon-carousel"
                    data-direction="right"
                    aria-label="Scroll ending-soon auctions right"
                ) ›

        .auction-carousel#ending-soon-carousel

            each auction in endingSoonAuctions

                article.auction-card.carousel-card

                    .auction-card-image

                        if auction.imagePath

                            img(
                                src=auction.imagePath
                                alt=auction.title
                            )

                        else

                            | Product Image

                    .auction-card-content

                        h3= auction.title

                        p
                            strong Current Bid:
                            |  £#{auction.currentBid.toFixed(2)}

                        p
                            strong Bids:
                            |  #{auction.bidCount}

                        p
                            strong Time Remaining:
                            |  #{auction.timeRemaining}

                        a.secondary-button(
                            href=`/auction/${auction.id}`
                        ) View Auction