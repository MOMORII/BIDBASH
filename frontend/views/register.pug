extends layout

block content
    section.login-page
        h1 Create an Account

        p Register for a BIDBASH account to place bids, sell items, and access account-specific auction activity.

        if message
            p= message

        form(method="POST" action="/register")
            .form-group
                label(for="username") Username
                input#username(
                    type="text"
                    name="username"
                    required
                )

            .form-group
                label(for="email") Email
                input#email(
                    type="email"
                    name="email"
                    required
                )

            .form-group
                label(for="password") Password
                input#password(
                    type="password"
                    name="password"
                    required
                )

            button.primary-button(type="submit") Sign Up

        p
            | Already registered? 
            a(href="/login") Login