extends layout

block content

    section.auth-page

        .auth-shell

            .auth-brand-panel

                .auth-brand-content

                    span.auth-eyebrow JOIN BIDBASH

                    h1 Ready to bid, bash and battle?

                    p
                        | Create your account to start bidding, selling and managing auction activity through BIDBASH.

                    .auth-brand-points

                        .auth-brand-point
                            span.auth-brand-icon ✓
                            p Discover active auctions

                        .auth-brand-point
                            span.auth-brand-icon ✓
                            p Place and monitor your bids

                        .auth-brand-point
                            span.auth-brand-icon ✓
                            p Create and manage listings

            .auth-form-panel

                .auth-form-header

                    span.auth-form-label CREATE ACCOUNT

                    h2 Sign Up

                    p Set up your BIDBASH account to get started.

                if error

                    .auth-message.auth-message-error
                        p= error

                form.auth-form(
                    method="POST"
                    action="/register"
                )

                    .auth-field

                        label(
                            for="username"
                        ) Username

                        input(
                            type="text"
                            id="username"
                            name="username"
                            placeholder="Choose a username"
                            autocomplete="username"
                            required
                        )

                    .auth-field

                        label(
                            for="password"
                        ) Password

                        input(
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Create a password"
                            autocomplete="new-password"
                            required
                        )

                    .auth-field

                        label(
                            for="confirm-password"
                        ) Confirm Password

                        input(
                            type="password"
                            id="confirm-password"
                            name="confirmPassword"
                            placeholder="Repeat your password"
                            autocomplete="new-password"
                            required
                        )

                    .auth-consent

                        input(
                            type="checkbox"
                            id="terms"
                            name="terms"
                            required
                        )

                        label(
                            for="terms"
                        )
                            | I agree to the 
                            a(
                                href="/terms"
                            ) Terms & Conditions
                            |  and 
                            a(
                                href="/privacy"
                            ) Privacy Policy
                            | .

                    button.auth-primary-button(
                        type="submit"
                    ) Create Account

                .auth-switch

                    p
                        | Already have an account?

                    a(
                        href="/login"
                    ) Sign in instead