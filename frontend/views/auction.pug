extends layout

block content

    section.auction-page

        .auction-main

            .auction-image-panel

                if auction.imagePath

                    img.auction-product-image(
                        src=auction.imagePath
                        alt=auction.title
                    )

                else

                    .image-placeholder.large
                        | Product Image

            .auction-info

                p.auction-category= auction.category

                h1= auction.title

                .product-meta

                    p

                        strong Condition:
                        |  #{auction.condition}

                    p

                        strong Brand:
                        |  #{auction.brand}

                    p

                        strong Seller:
                        |  #{auction.seller}

                p.product-description= auction.description

                .auction-status-panel

                    .status-item

                        span.label Current Bid

                        strong#auction-current-bid
                            | £#{auction.currentBid.toFixed(2)}

                    .status-item

                        span.label Minimum Next Bid

                        strong#auction-minimum-bid
                            | £#{auction.minimumBid.toFixed(2)}

                    .status-item

                        span.label Time Remaining

                        strong= auction.timeRemaining

                if user

                    form.bid-panel#bid-panel

                        label(
                            for="bid-amount"
                        )
                            | Your Bid

                        .bid-input-row

                            input#bid-amount(
                                type="number"
                                inputmode="decimal"
                                min=auction.minimumBid
                                step=auction.bidIncrement
                                placeholder="Enter bid amount"
                                aria-label="Enter bid amount"
                            )

                            button.primary-button#place-bid-button(
                                type="button"
                            )
                                | Place Your Bid

                        p.bid-help#bid-help
                            | Type an amount or use the arrows. Minimum valid bid: £#{auction.minimumBid.toFixed(2)}

                    .auction-message

                        p

                            strong Status:
                            |  Place a valid bid to enter this auction.

                    if Number(user.id) !== Number(auction.sellerId)

                        .auction-report-section

                            button.secondary-button#report-listing-button(
                                type="button"
                            )
                                | Report Listing

                else

                    .bid-panel

                        h3
                            | Want to place a bid?

                        p
                            | You must be logged into a registered BIDBASH account before placing a bid.

                        a.primary-button(
                            href="/login"
                        )
                            | Login to Bid

                    .auction-report-section

                        a.secondary-button(
                            href="/login"
                        )
                            | Login to Report Listing

        section.auction-support

            .auction-support-left

                section.info-card

                    h2
                        | Delivery

                    p
                        = auction.deliveryInfo || "Standard UK delivery available."

                section.info-card

                    h2
                        | Returns

                    p
                        = auction.returnInfo || "Returns accepted within 14 days where applicable."

            section.info-card.auction-activity-card

                h2
                    | Auction Activity

                p
                    | #{auction.bidCount} bids placed

                p
                    | #{auction.activeBidders} active bidders

    if user

        //-displays bid confirmation and bid result feedback

        .modal-overlay#bid-confirmation-modal(
            hidden
        )

            .modal-card.bid-modal-card#bid-modal-card

                .listing-modal-header

                    div

                        h2#bid-modal-title
                            | Confirm Your Bid

                        p#bid-modal-message
                            | Review your bid before submitting it.

                    button.modal-close#bid-confirmation-close(
                        type="button"
                        aria-label="Close bid confirmation"
                    )
                        | ×

                .bid-confirmation-summary#bid-confirmation-summary

                    .bid-confirmation-item

                        span
                            | Item

                        strong
                            = auction.title

                    .bid-confirmation-item

                        span
                            | Your Bid

                        strong#confirmation-bid-amount
                            | £0.00

                    .bid-confirmation-item

                        span
                            | Current Highest Bid

                        strong#confirmation-current-bid
                            | £#{auction.currentBid.toFixed(2)}

                    .bid-confirmation-item

                        span
                            | Minimum Valid Bid

                        strong#confirmation-minimum-bid
                            | £#{auction.minimumBid.toFixed(2)}

                p.bid-confirmation-note#bid-confirmation-note
                    | All bids are binding. By confirming, you agree to BIDBASH's Terms *&* Conditions.

                .modal-actions#bid-confirmation-actions

                    button.secondary-button#cancel-bid-button(
                        type="button"
                    )
                        | Cancel

                    button.primary-button#confirm-bid-button(
                        type="button"
                        data-auction-id=auction.id
                    )
                        | Confirm Bid

                .bid-result-content#bid-result-content(
                    hidden
                )

                    p.bid-result-detail#bid-result-detail

                    .bid-result-highlight#bid-result-highlight(
                        hidden
                    )

                .modal-actions#bid-result-actions(
                    hidden
                )

                    button.primary-button#bid-result-close(
                        type="button"
                    )
                        | Continue

        if Number(user.id) !== Number(auction.sellerId)

            //-displays listing report form

            .modal-overlay#report-listing-modal(
                hidden
            )

                .modal-card.listing-modal-card

                    .listing-modal-header

                        div

                            h2 Report Listing

                            p
                                | Tell us why this listing should be reviewed by a moderator.

                        button.modal-close#report-listing-close(
                            type="button"
                            aria-label="Close report listing form"
                        )
                            | ×

                    form#report-listing-form(
                        data-listing-id=auction.listingId
                    )

                        .form-group

                            label(
                                for="report-type"
                            )
                                | Report Type

                            select#report-type(
                                name="reportType"
                                required
                            )

                                option(
                                    value=""
                                )
                                    | Select Report Type

                                option(
                                    value="prohibited"
                                )
                                    | Prohibited Item

                                option(
                                    value="counterfeit"
                                )
                                    | Counterfeit

                                option(
                                    value="misleading"
                                )
                                    | Misleading Listing

                                option(
                                    value="unsafe"
                                )
                                    | Unsafe Item

                                option(
                                    value="restricted"
                                )
                                    | Restricted Listing

                        .form-group

                            label(
                                for="report-reason"
                            )
                                | Reason

                            input#report-reason(
                                type="text"
                                name="reason"
                                placeholder="Briefly explain the issue"
                                required
                            )

                        .form-group

                            label(
                                for="report-description"
                            )
                                | Additional Details

                            textarea#report-description(
                                name="description"
                                rows="5"
                                placeholder="Add any useful details for the moderator"
                            )

                        p.form-message.form-error#report-listing-error(
                            hidden
                        )

                        p.form-message.form-success#report-listing-success(
                            hidden
                        )

                        .modal-actions

                            button.secondary-button#report-listing-cancel(
                                type="button"
                            )
                                | Cancel

                            button.primary-button#submit-report-button(
                                type="submit"
                            )
                                | Submit Report