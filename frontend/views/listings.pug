extends layout

block content

    section.dashboard-top.listings-top

        .listings-header-content

            .dashboard-heading

                h1 My Listings

                p Manage your active auctions, successful sales, and listing history.

                button.primary-button#create-listing-button(
                    type="button"
                ) Create Listing

            nav.dashboard-tabs

                button.dashboard-tab.active(
                    type="button"
                    data-dashboard-target="active-listings"
                ) Active Listings

                button.dashboard-tab(
                    type="button"
                    data-dashboard-target="successful-sales"
                ) Successful Sales

                button.dashboard-tab(
                    type="button"
                    data-dashboard-target="listing-history"
                ) Listing History

        img.header-image.listings-header-image#home-header-image(
            src="/images/header-img.png"
            alt="BIDBASH illustration"
        )

    section.dashboard-section.dashboard-panel#active-listings

        if listings.active.length

            .dashboard-list

                each listing in listings.active

                    article.dashboard-item

                        .dashboard-image

                            if listing.imagePath

                                img(
                                    src=listing.imagePath
                                    alt=listing.title
                                )

                            else

                                | Product Image

                        .dashboard-item-content

                            h3= listing.title

                            .dashboard-item-details

                                p
                                    strong Current Bid:
                                    |  £#{listing.currentBid.toFixed(2)}
                                p
                                    strong Time Remaining:
                                    |  #{listing.timeRemaining}

                        .dashboard-actions

                            if listing.auctionId

                                a.secondary-button(
                                    href=`/auction/${listing.auctionId}`
                                ) View Auction

                            button.dashboard-action-button.manage-listing-button(
                                type="button"
                                data-listing-id=listing.id
                                data-title=listing.title
                                data-category=listing.category
                                data-condition=listing.condition
                                data-brand=listing.brand || ""
                                data-description=listing.description
                                data-starting-price=listing.startingPrice
                                data-bid-increment=listing.bidIncrement
                                data-delivery-info=listing.deliveryInfo || ""
                                data-return-info=listing.returnInfo || ""
                                data-bid-count=listing.bidCount
                            ) Manage

        else

            p.dashboard-empty
                | You currently have no active listings.

    section.dashboard-section.dashboard-panel#successful-sales(
        hidden
    )

        if listings.successful.length

            .dashboard-list

                each listing in listings.successful

                    article.dashboard-item

                        .dashboard-image

                            if listing.imagePath

                                img(
                                    src=listing.imagePath
                                    alt=listing.title
                                )

                            else

                                | Product Image

                        .dashboard-item-content

                            h3= listing.title

                            .dashboard-item-details

                                p
                                    strong Final Amount:
                                    |  £#{listing.finalAmount.toFixed(2)}

                                p
                                    strong Buyer:
                                    |  #{listing.buyer || "Not available"}

                                p
                                    strong Payment:
                                    |  #{listing.paymentStatus}

                                p
                                    strong Fulfilment:
                                    |  #{listing.fulfilmentStatus}

                                if listing.trackingReference

                                    p
                                        strong Tracking:
                                        |  #{listing.trackingReference}

                                if listing.rawPaymentStatus === "paid" && listing.rawFulfilmentStatus === "awaiting-dispatch"

                                    .dispatch-order-controls

                                        label(
                                            for=`tracking-reference-${listing.orderId}`
                                        ) Tracking Reference

                                        input.dispatch-tracking-input(
                                            id=`tracking-reference-${listing.orderId}`
                                            type="text"
                                            placeholder="Enter tracking reference"
                                            data-order-id=listing.orderId
                                        )

                        .dashboard-actions

                            if listing.auctionId

                                a.secondary-button(
                                    href=`/auction/${listing.auctionId}`
                                ) View Auction

                            if listing.rawPaymentStatus === "paid" && listing.rawFulfilmentStatus === "awaiting-dispatch"

                                button.primary-button.dispatch-order-button(
                                    type="button"
                                    data-order-id=listing.orderId
                                ) Mark as Dispatched

                            else if !listing.rawPaymentStatus

                                span.dashboard-status
                                    | Awaiting Buyer Payment

                            else if listing.rawFulfilmentStatus === "dispatched"

                                span.dashboard-status
                                    | Dispatched

                            else if listing.rawFulfilmentStatus === "delivered"

                                span.dashboard-status
                                    | Delivered

        else

            p.dashboard-empty
                | You currently have no successful sales.

    section.dashboard-section.dashboard-panel#listing-history(
        hidden
    )

        if listings.history.length

            .dashboard-list

                each listing in listings.history

                    article.dashboard-item

                        .dashboard-image

                            if listing.imagePath

                                img(
                                    src=listing.imagePath
                                    alt=listing.title
                                )

                            else

                                | Product Image

                        .dashboard-item-content

                            h3= listing.title

                            .dashboard-item-details

                                p
                                    strong Outcome:
                                    |  #{listing.outcome}

                                if listing.finalAmount !== null

                                    p
                                        strong Final Amount:
                                        |  £#{listing.finalAmount.toFixed(2)}

                                p
                                    strong Completed:
                                    |  #{listing.completedAt}

                        .dashboard-actions

                            if listing.auctionId

                                a.secondary-button(
                                    href=`/auction/${listing.auctionId}`
                                ) View Details

        else

            p.dashboard-empty
                | Your listing history is currently empty.

    //-displays the create listing form over the dashboard

    .modal-overlay#create-listing-modal(
        hidden=!openCreateListing
    )

        .modal-card.listing-modal-card

            .listing-modal-header

                div

                    h2 Create Listing

                    p Add the information required for a new auction listing.

                button.modal-close#create-listing-close(
                    type="button"
                    aria-label="Close create listing form"
                ) ×

            if listingError

                p.form-message.form-error= listingError

            if listingMessage

                p.form-message.form-success= listingMessage

            form.listing-form(
                method="POST"
                action="/listings/new"
                enctype="multipart/form-data"
            )

                .form-row

                    .form-group

                        label(for="title") Listing Title

                        input#title(
                            type="text"
                            name="title"
                            placeholder="Enter listing title"
                            required
                        )

                    .form-group

                        label(for="brand") Brand

                        input#brand(
                            type="text"
                            name="brand"
                            placeholder="Enter brand if applicable"
                        )

                .form-row

                    .form-group

                        label(for="category") Category

                        select#category(
                            name="category"
                            required
                        )

                            option(value="") Select Category
                            option(value="Electronics") Electronics
                            option(value="Collectibles") Collectibles
                            option(value="Fashion") Fashion
                            option(value="Home") Home
                            option(value="Gaming") Gaming
                            option(value="Sports") Sports
                            option(value="Books") Books
                            option(value="Music") Music

                    .form-group

                        label(for="condition") Condition

                        select#condition(
                            name="condition"
                            required
                        )

                            option(value="") Select Condition
                            option(value="New") New
                            option(value="Like New") Like New
                            option(value="Very Good") Very Good
                            option(value="Good") Good
                            option(value="Used") Used

                .form-group

                    label(for="description") Description

                    textarea#description(
                        name="description"
                        rows="3"
                        placeholder="Describe the item, condition, and important details"
                        required
                    )

                .form-row

                    .form-group

                        label(for="starting-price") Starting Price

                        input#starting-price(
                            type="number"
                            name="startingPrice"
                            min="0.01"
                            step="0.01"
                            placeholder="0.00"
                            required
                        )

                    .form-group

                        label(for="bid-increment") Bid Increment

                        input#bid-increment(
                            type="number"
                            name="bidIncrement"
                            min="0.01"
                            step="0.01"
                            placeholder="5.00"
                            required
                        )

                .form-row

                    .form-group

                        label(for="delivery-info") Delivery Information

                        textarea#delivery-info(
                            name="deliveryInfo"
                            rows="2"
                            placeholder="Enter delivery information"
                        )

                    .form-group

                        label(for="return-info") Return Information

                        textarea#return-info(
                            name="returnInfo"
                            rows="2"
                            placeholder="Enter return information"
                        )

                .form-group

                    label(for="listing-image") Listing Image

                    input#listing-image(
                        type="file"
                        name="listingImage"
                        accept=".jpg,.jpeg,.png,.webp"
                    )

                    p.form-help
                        | Upload one JPG, JPEG, PNG or WEBP image up to 5 MB.

                .modal-actions

                    button.secondary-button#create-listing-cancel(
                        type="button"
                    ) Cancel

                    button.primary-button(
                        type="submit"
                    ) Create Listing

    //-displays the edit listing form over the dashboard

    .modal-overlay#edit-listing-modal(
        hidden
    )

        .modal-card.listing-modal-card

            .listing-modal-header

                div

                    h2 Edit Listing

                    p Update the information shown on your active auction.

                button.modal-close#edit-listing-close(
                    type="button"
                    aria-label="Close edit listing form"
                ) ×

            p.form-message.form-error#edit-listing-error(
                hidden
            )

            form.listing-form#edit-listing-form(
                enctype="multipart/form-data"
            )

                input#edit-listing-id(
                    type="hidden"
                )

                .form-row

                    .form-group

                        label(for="edit-title") Listing Title

                        input#edit-title(
                            type="text"
                            required
                        )

                    .form-group

                        label(for="edit-brand") Brand

                        input#edit-brand(
                            type="text"
                        )

                .form-row

                    .form-group

                        label(for="edit-category") Category

                        select#edit-category(
                            required
                        )

                            option(value="Electronics") Electronics
                            option(value="Collectibles") Collectibles
                            option(value="Fashion") Fashion
                            option(value="Home") Home
                            option(value="Gaming") Gaming
                            option(value="Sports") Sports
                            option(value="Books") Books
                            option(value="Music") Music

                    .form-group

                        label(for="edit-condition") Condition

                        select#edit-condition(
                            required
                        )

                            option(value="New") New
                            option(value="Like New") Like New
                            option(value="Very Good") Very Good
                            option(value="Good") Good
                            option(value="Used") Used

                .form-group

                    label(for="edit-description") Description

                    textarea#edit-description(
                        rows="3"
                        required
                    )

                .form-row

                    .form-group

                        label(for="edit-starting-price") Starting Price

                        input#edit-starting-price(
                            type="number"
                            min="0.01"
                            step="0.01"
                            required
                        )

                    .form-group

                        label(for="edit-bid-increment") Bid Increment

                        input#edit-bid-increment(
                            type="number"
                            min="0.01"
                            step="0.01"
                            required
                        )

                p.form-help#edit-pricing-help(
                    hidden
                )
                    | Starting price and bid increment are locked because this auction already has bids.

                .form-row

                    .form-group

                        label(for="edit-delivery-info") Delivery Information

                        textarea#edit-delivery-info(
                            rows="2"
                        )

                    .form-group

                        label(for="edit-return-info") Return Information

                        textarea#edit-return-info(
                            rows="2"
                        )

                .form-group

                    label(for="edit-listing-image") Replace Listing Image

                    input#edit-listing-image(
                        type="file"
                        name="listingImage"
                        accept=".jpg,.jpeg,.png,.webp"
                    )

                    p.form-help
                        | Leave this empty to keep the current listing image.

                .modal-actions

                    button.secondary-button#edit-listing-cancel(
                        type="button"
                    ) Cancel

                    button.primary-button#save-listing-button(
                        type="submit"
                    ) Save Changes