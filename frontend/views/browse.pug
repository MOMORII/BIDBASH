extends layout

block sidebar
    section.sidebar-filters
        h2 Filters

        .filter-group
            label(for="category-filter") Category

            select#category-filter
                option(
                    value="all"
                    selected=activeCategory === "all"
                ) All Categories

                option(
                    value="electronics"
                    selected=activeCategory === "electronics"
                ) Electronics

                option(
                    value="collectibles"
                    selected=activeCategory === "collectibles"
                ) Collectibles

                option(
                    value="gaming"
                    selected=activeCategory === "gaming"
                ) Gaming

                option(
                    value="home"
                    selected=activeCategory === "home"
                ) Home & Living

                option(
                    value="fashion"
                    selected=activeCategory === "fashion"
                ) Fashion

        .filter-group
            label(for="condition-filter") Condition

            select#condition-filter
                option(value="all") All Conditions
                option(value="new") New
                option(value="very-good") Used - Very Good
                option(value="good") Used - Good

        .filter-group
            label Price Range

            .price-filter-row
                input(
                    type="number"
                    placeholder="Min"
                    min="0"
                )

                input(
                    type="number"
                    placeholder="Max"
                    min="0"
                )

        button.primary-button(
            type="button"
        ) Apply Filters

block content
    section.dashboard-top.browse-top
        .dashboard-header
            .dashboard-heading
                h1 Browse Auctions
                p Search, filter, and explore active BIDBASH auction listings.

        .browse-header-controls
            input#browse-search(
                type="search"
                placeholder="Search auctions"
                aria-label="Search auctions"
            )

            select#browse-sort(
                aria-label="Sort auctions"
            )
                option(
                    value="featured"
                    selected=activeSort === "featured"
                ) Featured Auctions

                option(
                    value="ending-soon"
                    selected=activeSort === "ending-soon"
                ) Ending Soon

                option(
                    value="newest"
                    selected=activeSort === "newest"
                ) Newly Listed

                option(
                    value="price-low"
                    selected=activeSort === "price-low"
                ) Price: Low to High

                option(
                    value="price-high"
                    selected=activeSort === "price-high"
                ) Price: High to Low

    section.browse-page
        section.browse-results
            .browse-results-header
                if activeCategory !== "all"
                    p
                        | Showing #{activeCategory} auctions

                else if activeSort === "featured"
                    p
                        | Showing featured auctions

                else if activeSort === "ending-soon"
                    p
                        | Showing auctions ending soon

                else if activeSort === "newest"
                    p
                        | Showing newly listed auctions

                else if activeSort === "price-low"
                    p
                        | Showing auctions from lowest to highest current bid

                else if activeSort === "price-high"
                    p
                        | Showing auctions from highest to lowest current bid

                else
                    p
                        | Showing available auctions

            .auction-grid
                if auctions.length
                    each auction in auctions
                        article.auction-card
                            .auction-card-image
                                | Product Image

                            .auction-card-content
                                h2= auction.title

                                p
                                    strong Current Bid:
                                    |  £#{auction.currentBid.toFixed(2)}

                                p
                                    strong Bids:
                                    |  #{auction.bidCount}

                                p
                                    strong Seller:
                                    |  #{auction.seller}

                                p
                                    strong Time Remaining:
                                    |  #{auction.timeRemaining}

                                a.secondary-button(
                                    href=`/auction/${auction.id}`
                                ) View Auction

                else
                    p.dashboard-empty
                        | No auctions match the selected filters.