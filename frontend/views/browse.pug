extends layout

block sidebar
    section.sidebar-filters
        h2 Filters

        .filter-group
            label(for="category-filter") Category

            select#category-filter
                option(value="all") All Categories
                option(value="electronics") Electronics
                option(value="collectibles") Collectibles
                option(value="gaming") Gaming
                option(value="home") Home

        .filter-group
            label(for="condition-filter") Condition

            select#condition-filter
                option(value="all") All Conditions
                option(value="new") New
                option(value="very-good") Used - Very Good
                option(value="good") Used - Good

        .filter-group
            label Price Range

            .price-filter-row
                input(
                    type="number"
                    placeholder="Min"
                    min="0"
                )

                input(
                    type="number"
                    placeholder="Max"
                    min="0"
                )

        button.primary-button(
            type="button"
        ) Apply Filters

block content
    section.dashboard-top.browse-top
        .dashboard-header
            .dashboard-heading
                h1 Browse Auctions
                p Search, filter, and explore active BIDBASH auction listings.

        .browse-header-controls
            input#browse-search(
                type="search"
                placeholder="Search auctions"
                aria-label="Search auctions"
            )

            select#browse-sort(
                aria-label="Sort auctions"
            )
                option(value="ending-soon") Ending Soon
                option(value="newest") Newest Listings
                option(value="price-low") Price: Low to High
                option(value="price-high") Price: High to Low

    section.browse-page
        section.browse-results
            .browse-results-header
                p Showing available auctions

