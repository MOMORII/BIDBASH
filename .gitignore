# The .gitignore file is used to specify all the types of folders/files that should NOT be copied to the git repo
# Structure was inspired by the .gitignore I made for my data engineering internship, though not as a direct copy (security reasons)
# Updated as of 2026-09-10

# node dependencies
node_modules/

# environment variables and secrets
node_modules/

#tmp tagged
#.env
#*.env

# sqlite databases
*.db
*.sqlite
*.sqlite3

# logs
*.log
npm-debug.log*

# temporary files
tmp/
temp/

# generated uploads
uploads/

# editor files
.vscode/
.idea/

# operating system files
.DS_Store
Thumbs.db